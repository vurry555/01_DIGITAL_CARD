[connection signal="pressed" from="MarginContainer/VBoxContainer/HBoxContainer/DevButton" to="." method="_on_dev_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/HBoxContainer/DesignButton" to="." method="_on_design_button_pressed"]
